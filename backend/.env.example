JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=replace-with-a-random-password-of-at-least-16-characters
DASHBOARD_ORIGIN=http://localhost:5173
# One exact origin, or several separated by commas when one backend serves the
# dashboard at more than one address (for example http://localhost:5173,http://127.0.0.1:5173).
# Each entry is matched exactly; a port or path change is a different origin.
PORT=3000
TRUST_PROXY_HOPS=0
# Matching APK enrollment is enabled by the bundled invitation hash.
# Optional: AUTO_ENROLLMENT_KEY_HASH=disabled stops future automatic joins.
# Optional: use a SHA-256 hex hash here to rotate the installation invitation.
# Optional HTTPS: set both paths to your real certificate and private key.
# TLS_CERT_PATH=/absolute/path/fullchain.pem
# TLS_KEY_PATH=/absolute/path/privkey.pem

# Optional persistent PostgreSQL. Leave unset for local SQLite. Required on Render.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
# DATABASE_PATH=/absolute/local/path/devices.sqlite
# PG_SSL_MODE=disable is supported only for local PostgreSQL tests; never set it on Render.

# Cloud data retention in days (integer 1-3650, default 30). A sweep runs at startup and every
# six hours: it removes received events, uploaded files, idempotency receipts, finished tool
# requests and abandoned enrollment requests older than this. Captured photos, audio and
# screenshots go too, so export anything you want to keep from the dashboard first.
# RETENTION_DAYS=30

# Optional: tell phones which APK you actually host. /health then answers latest_app_version
# (and latest_app_url when set), and a phone only mentions an update when that version is strictly
# newer than its own build. Leave both unset if you do not want to advertise a release yet.
# APP_RELEASE_VERSION=0.5.0
# APP_RELEASE_URL=https://example.com/SystemHealth-0.5.0.apk
