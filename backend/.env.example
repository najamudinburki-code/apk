JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=replace-with-a-random-password-of-at-least-16-characters
DASHBOARD_ORIGIN=http://localhost:5173
PORT=3000
TRUST_PROXY_HOPS=0
# Matching APK enrollment is enabled by the bundled invitation hash.
# Optional: AUTO_ENROLLMENT_KEY_HASH=disabled stops future automatic joins.
# Optional: use a SHA-256 hex hash here to rotate the installation invitation.
# Optional HTTPS: set both paths to your real certificate and private key.
# TLS_CERT_PATH=/absolute/path/fullchain.pem
# TLS_KEY_PATH=/absolute/path/privkey.pem

# Optional persistent PostgreSQL. Leave unset for local SQLite. Required on Render.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
# DATABASE_PATH=/absolute/local/path/devices.sqlite
# PG_SSL_MODE=disable is supported only for local PostgreSQL tests; never set it on Render.
